# Copy to .env (scripts/setup.* does this for you). Real environment variables win.
# Default model. For very low-resource machines use: qwen3:0.6b
MSL_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://localhost:11434
# Keep 127.0.0.1 so only this computer can open the app.
MSL_HOST=127.0.0.1
MSL_PORT=8000
MSL_DB_PATH=data/memory_seance.db
# Memories sent to the model per request (3-5)
MSL_TOP_K=4
# Seconds to wait for the model before giving up
MSL_TIMEOUT=120
